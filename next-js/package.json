{
  "name": "nextpress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0",
    "compile": "cross-env NODE_ENV=production next build --experimental-build-mode compile",
    "generate": "next build --experimental-build-mode generate",
    "start": "next start",
    "kysely-codegen": "kysely-codegen --singularize --camel-case --dialect mysql --out-file ./src/lib/nextpress/types/wpdb/wpdb.d.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dataloader": "^2.2.3",
    "html-react-parser": "^6.1.2",
    "isomorphic-dompurify": "^3.14.0",
    "kysely": "^0.29.2",
    "mysql2": "^3.22.3",
    "next": "16.2.6",
    "php-serialize": "^5.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
